{
  "name": "honey-check-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src vite.config.ts",
    "format": "prettier --config ../../../prettier.config.mjs --write src vite.config.ts eslint.config.js",
    "format:check": "prettier --config ../../../prettier.config.mjs --check src vite.config.ts eslint.config.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "gsap": "^3.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^9.39.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.4.5"
  }
}
